  "selfLoopContract": {
    "pass": [
      "requires gate PASS",
      "marks current Stage COMPLETED",
      "completes Milestone when all member Stages complete",
      "activates next Stage / next Milestone",
      "completes Project and Run when final Stage passes"
    ],
    "retry": [
      "requires gate FAIL or HOLD",
      "keeps/reopens Stage ACTIVE",
      "increments Stage attempt_count",
      "increments current Task retry_count when task supplied",
      "restores Project ACTIVE and Run RUNNING",
      "fails closed when configured maxRetries is exceeded"
    ],
    "escalate": [
      "requires gate FAIL or HOLD",
      "marks Stage and Milestone BLOCKED",
      "marks Project BLOCKED and Run HOLD",
      "records blocking reason",
      "may be resumed through an explicit RETRY or resolved with a later PASS"
    ],
    "rollback": [
      "requires gate FAIL or HOLD and an earlier target Stage",
      "reactivates target Stage",
      "resets target-and-later lifecycle Stages to PENDING except target ACTIVE",
      "reopens target Milestone and resets later Milestones",
      "cancels the current Task with STAGE_ROLLBACK",
      "restores Project ACTIVE and Run RUNNING"
    ]
  },
