# Copy to .env.runtime on the VPS. Never commit real passwords.
MYSQL_DATABASE=ai_native_runtime
MYSQL_USER=ai_native_runtime
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Runtime API connection string (example)
DATABASE_URL=mysql://ai_native_runtime:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:3306/ai_native_runtime
